# ---- server ----
PORT=8100
HOST=0.0.0.0

# ---- access control (set BOTH to require a login; leave empty for open access) ----
AUTH_USER=
AUTH_PASS=

# ---- abuse protection ----
# searches per hour per IP
RATE_LIMIT=40
# max concurrent visitor sessions held in memory
MAX_SESSIONS=400

# ---- optional: licensed SERP data instead of scraping (recommended in production) ----
SERPAPI_KEY=
